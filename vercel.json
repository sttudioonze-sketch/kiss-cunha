{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blank",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/terapias",
      "destination": "/terapias/",
      "permanent": true
    },
    {
      "source": "/guia-terapias-s8estc/?",
      "destination": "/terapias/",
      "permanent": true
    },
    {
      "source": "/guia-terapias-s8estc/(.+)",
      "destination": "/terapias/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/terapias/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
